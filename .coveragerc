[run]
omit =
    api/src/main.py
    api/src/bootstrap/application.py
    api/src/shared/infrastructure/config.py
    api/src/__init__.py
    api/src/features/*/application/ports/**
    api/src/shared/application/**
    api/src/features/verification/infrastructure/workers/verification_worker.py
    api/src/shared/infrastructure/database/models/__init__.py
    api/src/features/connectors/infrastructure/gateways/task_management/__init__.py
    api/src/features/connectors/infrastructure/gateways/source_control/__init__.py
    api/src/features/connectors/infrastructure/gateways/documentation/__init__.py
    api/src/features/connectors/infrastructure/gateways/planning/__init__.py
    api/src/features/connectors/infrastructure/gateways/change_management/__init__.py
    api/src/shared/infrastructure/queue/__init__.py
    api/src/shared/infrastructure/queue/celery_app.py
    api/src/features/verification/infrastructure/workers/__init__.py
    */alembic/versions/*
    */alembic/env.py
    */migrations/*
    api/src/svaes_api.egg-info/*

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
